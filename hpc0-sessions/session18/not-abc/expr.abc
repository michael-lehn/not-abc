@ <stdio.hdr>
@ <stdlib.hdr>
@ "expr.hdr"

fn createUnaryExpr(kind: ExprKind, child: ->Expr): ->Expr
{
    local n: -> Expr = malloc(sizeof(*n));
    assert(n);
    n->kind = kind;
    n->unary.child = child;
    return n;
}

fn createBinaryExpr(kind: ExprKind, left: ->Expr, right: ->Expr): ->Expr
{
    local n: -> Expr = malloc(sizeof(*n));
    assert(n);
    n->kind = kind;
    n->binary.left = left;
    n->binary.right = right;
    return n;
}

fn createIntegerExpr(val: ->UStr): ->Expr
{
    local n: -> Expr = malloc(sizeof(*n));
    assert(n);
    n->kind = EXPR_INTEGER;
    n->primary.decimal = val;
    return n;
}

fn createCallExpr(fnName: ->UStr): ->Expr
{
    local n: -> Expr = malloc(sizeof(*n));
    n->kind = EXPR_CALL;
    n->primary.call.fnName = fnName;
    n->primary.call.argListLen = 0;
    n->primary.call.argList = nullptr;
    return n;
}

fn releaseExpr(expr: ->Expr)
{
    if (expr->kind >= EXPR_UNARY && expr->kind < EXPR_UNARY_END) {
	releaseExpr(expr->unary.child);
    } else if (expr->kind >= EXPR_BINARY && expr->kind < EXPR_BINARY_END) {
	releaseExpr(expr->binary.left);
	releaseExpr(expr->binary.right);
    } else if (expr->kind == EXPR_CALL) {
	if (expr->primary.call.argList) {
	    releaseExpr(expr->primary.call.argList);
	}
    } else if (expr->kind == EXPR_ARGNODE) {
	releaseExpr(expr->arg.expr);
	if (expr->arg.next) {
	    releaseExpr(expr->arg.next);
	}
    }
    free(expr);
}

fn addArgExpr(callExpr: ->Expr, argExpr: ->Expr)
{
    local n: -> Expr = malloc(sizeof(*n));
    n->kind = EXPR_ARGNODE;
    n->arg.expr = argExpr;
    n->arg.pos = callExpr->primary.call.argListLen;
    n->arg.next = callExpr->primary.call.argList;
    ++callExpr->primary.call.argListLen;
    callExpr->primary.call.argList = n;
}

fn printExprTree(expr: ->Expr)
{
    assert(expr);
    if (expr->kind >= EXPR_UNARY && expr->kind < EXPR_UNARY_END) {               
        printf("[ ");
        switch (expr->kind) {
            case EXPR_UNARY_MINUS: printf("- "); break;
            default: assert(0 && "node kind not handled");
        }
        printExprTree(expr->unary.child);
        printf("] ");
    } else if (expr->kind >= EXPR_PRIMARY && expr->kind < EXPR_PRIMARY_END) {               
        switch (expr->kind) {                                                    
            case EXPR_INTEGER:
		printf("[%s]", expr->primary.decimal);
		break;
	    case EXPR_CALL:
		printf("[call %s ", expr->primary.call.fnName);
		if (expr->primary.call.argList) {
		    printExprTree(expr->primary.call.argList);
		}
		printf("]");
		break;
            default: assert(0 && "node kind not handled");
	}
    } else if (expr->kind >= EXPR_BINARY && expr->kind < EXPR_BINARY_END) {               
        printf("[ ");
        switch (expr->kind) {
            case EXPR_ADD: printf("+ "); break;
            case EXPR_SUB: printf("- "); break;
            case EXPR_MUL: printf("* "); break;
            case EXPR_DIV: printf("/ "); break;
            case EXPR_MOD: printf("mod "); break;
            default: assert(0 && "node kind not handled");
        }
        printExprTree(expr->binary.left);
        printf(" ");
        printExprTree(expr->binary.right);
        printf("] ");
    } else if (expr->kind == EXPR_ARGNODE) { 
	if (expr->arg.next) {
	    printExprTree(expr->arg.next);
	}
	printExprTree(expr->arg.expr);
    } else {
        assert(0 && "node kind not handled");
    }
}

fn loadExpr(expr: ->Expr): GenReg
{
    if (expr->kind >= EXPR_PRIMARY && expr->kind < EXPR_PRIMARY_END) {
        switch (expr->kind) {                                                    
            case EXPR_INTEGER: return genConstant(expr->primary.decimal);
	    case EXPR_CALL:
		genCallBegin(expr->primary.call.fnName,
			     expr->primary.call.argListLen);
		for (local n: ->Expr = expr->primary.call.argList; n; n = n->arg.next) {
		    local argReg: GenReg = loadExpr(n->arg.expr);
		    genReleaseReg(argReg);
		    genCallAddArg(argReg, n->arg.pos);
		}
		return genCallEnd();
            default: assert(0 && "primary node kind not handled");                                                  
	}
    } else if (expr->kind >= EXPR_BINARY && expr->kind < EXPR_BINARY_END) {               
	local left: GenReg = loadExpr(expr->binary.left);
	local right: GenReg = loadExpr(expr->binary.right);
	genReleaseReg(left);
	genReleaseReg(right);

        switch (expr->kind) {
            case EXPR_ADD: return genInstr(GEN_ADD, left, right);
            case EXPR_SUB: return genInstr(GEN_SUB, left, right);
            case EXPR_MUL: return genInstr(GEN_MUL, left, right);
            case EXPR_DIV: return genInstr(GEN_DIV, left, right);
            case EXPR_MOD: return genInstr(GEN_MOD, left, right);
            default: assert(0 && "binary node kind not handled");                                                  
        }
    } else {
	assert(0 && "case not handled");
    }
    return 0; // never reached
}
