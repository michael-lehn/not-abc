@ "gen.hdr"
@ "symtab.hdr"

fn main()
{
    genInit();
    // fn sum(a, b) {
    genFuncDefBegin("sum");
    genFuncDefParam("a");
    genFuncDefParam("b");

    // return 41;
    genReturn(genConstant("41"));

    // local r: u64;
    genAddLocal("r");

    // print offsets (relative to frame pointer)
    symtabPrintLocals();

    // }
    genFuncDefEnd();

    //fn main() {
    genFuncDefBegin("main");

    // return sum(20, 22) + 1;
    genCallBegin("sum", 2);
    genCallAddArg(genConstant("20"), 0);
    genCallAddArg(genConstant("22"), 1);
    genReturn(genInstr(GEN_ADD,
		       genCallEnd(),
		       genConstant("1")));

    // }
    genFuncDefEnd();
}
