@ "gen.hdr"
@ "symtab.hdr"

fn main()
{
    genInit();

    // global x: i64;
    genAddGlobal("x");

    // fn main() {
    genFuncDefBegin("main");

    // x = 42;
    {
	local rVal: GenReg = genConstant("42");
	local lValAddr: GenReg = genLoadAddr("x");
	genStore(rVal, lValAddr);
	genReleaseReg(rVal);
	genReleaseReg(lValAddr);
    }

    // if (x)
    local elseLabel: GenLabel = genGetLabel(); 
    local doneLabel: GenLabel = genGetLabel();
    {
	local xVal: GenReg = genLoadVar("x");
	genJumpIfFalse(xVal, elseLabel);
	genReleaseReg(xVal);
    }
    // { x = 0; }
    {
	local rVal: GenReg = genConstant("0");
	local lValAddr: GenReg = genLoadAddr("x");
	genStore(rVal, lValAddr);
	genReleaseReg(rVal);
	genReleaseReg(lValAddr);
	genJump(doneLabel);
    }
    // else { x = 1; }
    genDefLabel(elseLabel);
    {
	local rVal: GenReg = genConstant("1");
	local lValAddr: GenReg = genLoadAddr("x");
	genStore(rVal, lValAddr);
	genReleaseReg(rVal);
	genReleaseReg(lValAddr);
    }
    genDefLabel(doneLabel);

    // return x;
    {
	local xVal: GenReg = genLoadVar("x");
	genReturn(xVal);
	genReleaseReg(xVal);
    }
    genFuncDefEnd();
}
