fn printInt(n)
{
    if (n == 0) {
	putchar('0');
    } else {
	if (n / 10 > 0) {
	    printInt(n / 10);
	}
	putchar(n % 10 + '0');
    }
}

fn readInt()
{
    local n, ch;
    n = 0;
    ch = getchar();
    while (ch != '\n') {
	n = n * 10 + ch - '0';
	ch = getchar();
    }
    return n;
}

fn main()
{
    local n;
    n = readInt();
    printInt(n);
    putchar('\n');
}
